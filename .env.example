# === LLM (existing agent + clone brain) ===
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# === Notion memory (existing /ask-agent) ===
NOTION_API_KEY=secret_...
NOTION_AGENT_DATABASES={"alex":"<database-id>"}

# === D-ID (avatar/video, optional) ===
DID_API_KEY=

# === Voice clone (ElevenLabs) ===
ELEVENLABS_API_KEY=
# Set automatically after POST /clone/voice/enroll; can also be set manually
ELEVENLABS_VOICE_ID=
# ElevenLabs TTS model to use for speech
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Secret for encrypting voice samples and photos at rest (≥16 chars;
# a 64-char hex key is used directly). Generate: openssl rand -hex 32
VOICE_STORAGE_KEY=

# === First-boot admin (cloud deploys) ===
# If no users exist at startup, this account is created with full
# ('private') access — your login for the web app.
ADMIN_USER=richard
ADMIN_PASSWORD=

# === Music videos (Seedance via fal.ai) ===
FAL_KEY=
# Override to use Seedance Pro: fal-ai/bytedance/seedance/v1/pro/image-to-video
SEEDANCE_MODEL=fal-ai/bytedance/seedance/v1/lite/image-to-video

# === Storage base (cloud deploys) ===
# Point at the persistent disk mount; users/voice/media live under it.
# Defaults to the repo folder when unset.
CLONE_DATA_DIR=

# Optional API bypass token for /clone/* (scripts/integrations only —
# humans sign in through /clone/login instead; create users with
# `node clone/add-user.js <username> <audience>`).
# Generate with: openssl rand -hex 16
CLONE_API_TOKEN=

# Server
PORT=3000
