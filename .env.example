# === LLM (existing agent + clone brain) ===
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# === Notion memory (existing /ask-agent) ===
NOTION_API_KEY=secret_...
NOTION_AGENT_DATABASES={"alex":"<database-id>"}

# === D-ID (avatar/video, optional) ===
DID_API_KEY=

# === Voice clone (ElevenLabs) ===
ELEVENLABS_API_KEY=
# Set automatically after POST /clone/voice/enroll; can also be set manually
ELEVENLABS_VOICE_ID=
# ElevenLabs TTS model to use for speech
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# 32-byte hex key for encrypting voice samples at rest.
# Generate with: openssl rand -hex 32
VOICE_STORAGE_KEY=

# Shared secret protecting /clone/* endpoints. Strongly recommended when
# exposing the server beyond localhost (tunnel/LAN) for phone capture.
# Generate with: openssl rand -hex 16
CLONE_API_TOKEN=

# Server
PORT=3000
